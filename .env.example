VITE_API_BASE_URL=
VITE_ENV=

# OAuth 2.0 Client ID (Web application) từ Google Cloud Console — dùng cho nút "Tiếp tục với Google".
VITE_GOOGLE_CLIENT_ID=

# Hostname API dự phòng (DNS khác nhà cung cấp) — FE tự chuyển sang đây khi hostname chính không resolve.
VITE_API_BASE_URL_FALLBACK=

# VietMap từ VietMap Console
VITE_VIETMAP_API_KEY=
VITE_VIETMAP_TILEMAP_KEY=
