# --- Dependencies ---
node_modules
.pnpm-store/

# Dự án dùng pnpm — chặn lockfile của npm/yarn lọt vào repo (gây cài lệch, thiếu dep).
# Chỉ pnpm-lock.yaml được commit.
package-lock.json
yarn.lock

# --- Build Outputs ---
dist
dist-ssr
build/
bin/
obj/

# --- Environment Variables (BẢO MẬT) ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?
Thumbs.db

# --- Mobile (React Native / Expo) ---
.expo/
ios/Pods/
android/app/build/
android/.gradle
*.apk
*.ipa

# --- Testing ---
coverage/

# --- codegraph local index ---
.codegraph/

# --- Claude Code working dir ---
.claude/
.ds-sync/
ds-bundle/

# --- E2E (Playwright) ---
# Cấu hình cục bộ (mật khẩu Postgres) — đã khớp `.env.*` ở trên, ghi rõ để khỏi ai gỡ nhầm.
e2e/.env.e2e
!e2e/.env.e2e.example
# Kết quả chạy (trace/video/screenshot có thể chứa token đăng nhập của user test)
e2e/.results/
e2e/.report/
e2e/.auth/
# Thư mục mặc định của Playwright khi chạy ngoài playwright.config.ts
test-results/
playwright-report/
blob-report/
playwright/.cache/
