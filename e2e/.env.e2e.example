# Copy thành e2e/.env.e2e (đã gitignore) rồi sửa mật khẩu Postgres CỤC BỘ.
# Chốt chặn: host phải là localhost và tên DB phải chứa "e2e" — xem e2e/support/env.ts.
E2E_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/fengdeskai_e2e

# Tuỳ chọn
# E2E_API_PORT=5299
# E2E_WEB_PORT=5199
# E2E_BROWSER_CHANNEL=chrome        # hoặc msedge; để trống + `pnpm exec playwright install chromium` nếu muốn Chromium riêng
# E2E_BACKEND_DIR=../FengDeskAI     # đường dẫn repo BE, tính từ thư mục FE
